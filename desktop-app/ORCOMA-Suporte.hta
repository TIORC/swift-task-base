<html>
<head>
<title>ORCOMA Suporte</title>
<HTA:APPLICATION
  ID="ORCOMASuporte"
  APPLICATIONNAME="ORCOMA Suporte"
  BORDER="thin"
  BORDERSTYLE="normal"
  CAPTION="yes"
  ICON="icon.ico"
  MAXIMIZEBUTTON="no"
  MINIMIZEBUTTON="yes"
  SHOWINTASKBAR="yes"
  SINGLEINSTANCE="yes"
  SYSMENU="yes"
  VERSION="1.0"
  WINDOWSTATE="normal"
/>
<meta http-equiv="x-ua-compatible" content="ie=edge">
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body {
  font-family: 'Segoe UI', Tahoma, sans-serif;
  background: #0f172a;
  color: #e2e8f0;
  width: 420px;
  height: 540px;
  overflow: hidden;
}
.header {
  background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
  padding: 18px 20px;
  text-align: center;
  border-bottom: 1px solid #334155;
}
.header h1 {
  font-size: 18px;
  font-weight: 700;
  color: #38bdf8;
  margin-bottom: 4px;
}
.header p {
  font-size: 11px;
  color: #94a3b8;
}
.user-info {
  font-size: 10px;
  color: #64748b;
  margin-top: 6px;
  background: #1e293b;
  padding: 4px 10px;
  border-radius: 4px;
  display: inline-block;
}

/* LOGIN */
.login-screen {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40px 30px;
  height: calc(100% - 80px);
}
.login-screen h2 {
  font-size: 16px;
  color: #f1f5f9;
  margin-bottom: 20px;
}
.login-screen input {
  width: 100%;
  padding: 10px 12px;
  margin-bottom: 12px;
  border: 1px solid #334155;
  border-radius: 6px;
  background: #1e293b;
  color: #e2e8f0;
  font-size: 13px;
  outline: none;
}
.login-screen input:focus {
  border-color: #38bdf8;
}
.login-btn {
  width: 100%;
  padding: 10px;
  background: linear-gradient(135deg, #0ea5e9, #38bdf8);
  color: #fff;
  border: none;
  border-radius: 6px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  margin-top: 4px;
}
.login-btn:hover { opacity: 0.9; }
.login-error {
  color: #f87171;
  font-size: 12px;
  margin-top: 8px;
  text-align: center;
  min-height: 16px;
}

/* MAIN */
.main-screen {
  display: none;
  flex-direction: column;
  padding: 16px 20px;
  height: calc(100% - 80px);
}
.section-title {
  font-size: 13px;
  font-weight: 600;
  color: #94a3b8;
  margin-bottom: 10px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.buttons-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  margin-bottom: 16px;
}
.ticket-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 18px 10px;
  background: #1e293b;
  border: 1px solid #334155;
  border-radius: 10px;
  color: #e2e8f0;
  cursor: pointer;
  transition: all 0.15s;
  font-size: 12px;
  font-weight: 500;
}
.ticket-btn:hover {
  border-color: #38bdf8;
  background: #1e3a5f;
  transform: translateY(-1px);
}
.ticket-btn .icon {
  font-size: 28px;
  margin-bottom: 6px;
}
.desc-area {
  margin-bottom: 12px;
}
.desc-area textarea {
  width: 100%;
  height: 60px;
  padding: 8px 10px;
  border: 1px solid #334155;
  border-radius: 6px;
  background: #1e293b;
  color: #e2e8f0;
  font-size: 12px;
  resize: none;
  outline: none;
  font-family: 'Segoe UI', sans-serif;
}
.desc-area textarea:focus { border-color: #38bdf8; }
.status-msg {
  text-align: center;
  font-size: 12px;
  min-height: 20px;
  margin-bottom: 8px;
  padding: 4px;
  border-radius: 4px;
}
.status-msg.success { color: #4ade80; background: #14532d33; }
.status-msg.error { color: #f87171; background: #7f1d1d33; }
.status-msg.loading { color: #fbbf24; }
.footer-bar {
  display: flex;
  justify-content: center;
  margin-top: auto;
}
.logout-btn {
  background: none;
  border: 1px solid #475569;
  color: #94a3b8;
  padding: 6px 20px;
  border-radius: 6px;
  font-size: 11px;
  cursor: pointer;
}
.logout-btn:hover { border-color: #f87171; color: #f87171; }
</style>
<script>
var SUPABASE_URL = 'https://wisbzvooxrgyltbebuyb.supabase.co';
var SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Indpc2J6dm9veHJneWx0YmVidXliIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzQ0NTQ4NzksImV4cCI6MjA5MDAzMDg3OX0.UhZJGeVW5uLJ31TN7JsDfwzUxvbRtz62sWx6wNLlSic';

var session = null;
var machineInfo = { username: 'Desconhecido', hostname: 'Desconhecido' };
var fso = null;
var sessionFilePath = '';

// Init FSO for persistent storage
try {
  fso = new ActiveXObject('Scripting.FileSystemObject');
  var wshShell = new ActiveXObject('WScript.Shell');
  var appData = wshShell.ExpandEnvironmentStrings('%APPDATA%');
  var appFolder = appData + '\\ORCOMA-Suporte';
  if (!fso.FolderExists(appFolder)) fso.CreateFolder(appFolder);
  sessionFilePath = appFolder + '\\session.json';
} catch(e) {}

// Get Windows machine info via WScript
try {
  var wshNetwork = new ActiveXObject('WScript.Network');
  machineInfo.username = wshNetwork.UserName;
  machineInfo.hostname = wshNetwork.ComputerName;
} catch(e) {}

function saveSession(data) {
  try {
    if (fso && sessionFilePath) {
      var f = fso.CreateTextFile(sessionFilePath, true);
      f.Write(data);
      f.Close();
    }
  } catch(e) {}
}

function loadSession() {
  try {
    if (fso && sessionFilePath && fso.FileExists(sessionFilePath)) {
      var f = fso.OpenTextFile(sessionFilePath, 1);
      var content = f.ReadAll();
      f.Close();
      return content;
    }
  } catch(e) {}
  return null;
}

function clearSession() {
  try {
    if (fso && sessionFilePath && fso.FileExists(sessionFilePath)) {
      fso.DeleteFile(sessionFilePath);
    }
  } catch(e) {}
}

function updateUserInfo() {
  var el = document.getElementById('user-info');
  if (el) el.innerText = machineInfo.username + ' \u2022 ' + machineInfo.hostname;
}

function onLoad() {
  window.resizeTo(440, 580);
  var sl = (screen.width - 440) / 2;
  var st = (screen.height - 580) / 2;
  window.moveTo(sl, st);

  updateUserInfo();

  // Restore session
  try {
    var saved = loadSession();
    if (saved) {
      session = JSON.parse(saved);
      showMainScreen();
    }
  } catch(e) {}
}

function showMainScreen() {
  document.getElementById('login-screen').style.display = 'none';
  document.getElementById('main-screen').style.display = 'flex';
  updateUserInfo();
}

function doLogin() {
  var email = document.getElementById('login-email').value;
  var password = document.getElementById('login-password').value;
  var errorEl = document.getElementById('login-error');
  var btn = document.getElementById('login-btn');

  if (!email || !password) {
    errorEl.innerText = 'Preencha email e senha';
    return;
  }

  btn.disabled = true;
  btn.innerText = 'Entrando...';
  errorEl.innerText = '';

  var xhr = new XMLHttpRequest();
  xhr.open('POST', SUPABASE_URL + '/auth/v1/token?grant_type=password', true);
  xhr.setRequestHeader('Content-Type', 'application/json');
  xhr.setRequestHeader('apikey', SUPABASE_ANON_KEY);
  xhr.onreadystatechange = function() {
    if (xhr.readyState === 4) {
      btn.disabled = false;
      btn.innerText = 'Entrar';
      if (xhr.status === 200) {
        session = JSON.parse(xhr.responseText);
        localStorage.setItem('orcoma_session', xhr.responseText);
        showMainScreen();
      } else {
        try {
          var err = JSON.parse(xhr.responseText);
          errorEl.innerText = err.error_description || err.msg || 'Credenciais inv\u00e1lidas';
        } catch(e) {
          errorEl.innerText = 'Erro ao conectar';
        }
      }
    }
  };
  xhr.send(JSON.stringify({ email: email, password: password }));
}

function doLogout() {
  session = null;
  localStorage.removeItem('orcoma_session');
  document.getElementById('login-screen').style.display = 'flex';
  document.getElementById('main-screen').style.display = 'none';
  document.getElementById('login-email').value = '';
  document.getElementById('login-password').value = '';
}

function createTicket(categoria) {
  var statusEl = document.getElementById('status-msg');
  var descricao = document.getElementById('description').value;
  var buttons = document.getElementsByClassName('ticket-btn');

  if (!session) {
    statusEl.className = 'status-msg error';
    statusEl.innerText = 'Sess\u00e3o expirada. Fa\u00e7a login novamente.';
    return;
  }

  for (var i = 0; i < buttons.length; i++) buttons[i].disabled = true;
  statusEl.className = 'status-msg loading';
  statusEl.innerText = '\u23F3 Criando chamado...';

  var xhr = new XMLHttpRequest();
  xhr.open('POST', SUPABASE_URL + '/functions/v1/support-ticket', true);
  xhr.setRequestHeader('Content-Type', 'application/json');
  xhr.setRequestHeader('Authorization', 'Bearer ' + session.access_token);
  xhr.setRequestHeader('apikey', SUPABASE_ANON_KEY);
  xhr.onreadystatechange = function() {
    if (xhr.readyState === 4) {
      for (var j = 0; j < buttons.length; j++) buttons[j].disabled = false;
      if (xhr.status === 200 || xhr.status === 201) {
        statusEl.className = 'status-msg success';
        statusEl.innerText = '\u2705 Chamado criado com sucesso!';
        document.getElementById('description').value = '';
        setTimeout(function() {
          statusEl.innerText = '';
          statusEl.className = 'status-msg';
        }, 3000);
      } else if (xhr.status === 401) {
        refreshAndRetry(categoria, descricao);
      } else {
        try {
          var err = JSON.parse(xhr.responseText);
          statusEl.className = 'status-msg error';
          statusEl.innerText = '\u274C ' + (err.error || 'Erro ao criar chamado');
        } catch(e) {
          statusEl.className = 'status-msg error';
          statusEl.innerText = '\u274C Erro ao criar chamado';
        }
      }
    }
  };
  xhr.send(JSON.stringify({
    categoria: categoria,
    descricao: descricao || null,
    usuario_windows: machineInfo.username,
    nome_maquina: machineInfo.hostname
  }));
}

function refreshAndRetry(categoria, descricao) {
  if (!session || !session.refresh_token) {
    doLogout();
    return;
  }
  var xhr = new XMLHttpRequest();
  xhr.open('POST', SUPABASE_URL + '/auth/v1/token?grant_type=refresh_token', true);
  xhr.setRequestHeader('Content-Type', 'application/json');
  xhr.setRequestHeader('apikey', SUPABASE_ANON_KEY);
  xhr.onreadystatechange = function() {
    if (xhr.readyState === 4) {
      if (xhr.status === 200) {
        session = JSON.parse(xhr.responseText);
        localStorage.setItem('orcoma_session', xhr.responseText);
        createTicket(categoria);
      } else {
        doLogout();
        var statusEl = document.getElementById('status-msg');
        statusEl.className = 'status-msg error';
        statusEl.innerText = 'Sess\u00e3o expirada. Fa\u00e7a login novamente.';
      }
    }
  };
  xhr.send(JSON.stringify({ refresh_token: session.refresh_token }));
}

function handleKeyPress(e) {
  if (e.keyCode === 13) doLogin();
}
</script>
</head>
<body onload="onLoad()">

<div class="header">
  <h1>ORCOMA Suporte</h1>
  <p>Abertura r&aacute;pida de chamados</p>
  <div class="user-info" id="user-info"></div>
</div>

<div id="login-screen" class="login-screen">
  <h2>Login</h2>
  <input type="text" id="login-email" placeholder="E-mail" />
  <input type="password" id="login-password" placeholder="Senha" onkeypress="handleKeyPress(event)" />
  <button class="login-btn" id="login-btn" onclick="doLogin()">Entrar</button>
  <div class="login-error" id="login-error"></div>
</div>

<div id="main-screen" class="main-screen">
  <div class="section-title">Tipo do chamado</div>
  <div class="buttons-grid">
    <button class="ticket-btn" onclick="createTicket('computador')">
      <span class="icon">&#128187;</span> Computador
    </button>
    <button class="ticket-btn" onclick="createTicket('sistema')">
      <span class="icon">&#129534;</span> Sistema
    </button>
    <button class="ticket-btn" onclick="createTicket('impressora')">
      <span class="icon">&#128424;</span> Impressora
    </button>
    <button class="ticket-btn" onclick="createTicket('ramal')">
      <span class="icon">&#9742;</span> Ramal
    </button>
  </div>

  <div class="desc-area">
    <div class="section-title">Descri&ccedil;&atilde;o (opcional)</div>
    <textarea id="description" placeholder="Descreva o problema..."></textarea>
  </div>

  <div class="status-msg" id="status-msg"></div>

  <div class="footer-bar">
    <button class="logout-btn" onclick="doLogout()">Sair</button>
  </div>
</div>

</body>
</html>
