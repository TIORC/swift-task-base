<html>
<head>
<title>ORCOMA Suporte</title>
<HTA:APPLICATION
  ID="ORCOMASuporte"
  APPLICATIONNAME="ORCOMA Suporte"
  BORDER="thin"
  BORDERSTYLE="normal"
  CAPTION="yes"
  ICON="icon.ico"
  MAXIMIZEBUTTON="no"
  MINIMIZEBUTTON="yes"
  SHOWINTASKBAR="yes"
  SINGLEINSTANCE="yes"
  SYSMENU="yes"
  VERSION="2.0"
  WINDOWSTATE="normal"
/>
<meta http-equiv="x-ua-compatible" content="ie=edge">
<style>
@font-face { font-family: 'Segoe UI'; }
* { margin: 0; padding: 0; box-sizing: border-box; }
body {
  font-family: 'Segoe UI', Tahoma, sans-serif;
  background: #0b1120;
  color: #e2e8f0;
  width: 440px;
  height: 620px;
  overflow: hidden;
  -webkit-font-smoothing: antialiased;
}

/* ===== HEADER ===== */
.header {
  background: linear-gradient(180deg, #0f1a2e 0%, #0b1120 100%);
  padding: 20px 24px 16px;
  border-bottom: 1px solid rgba(56, 189, 248, 0.15);
  position: relative;
}
.header-top {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 4px;
}
.logo-icon {
  width: 36px;
  height: 36px;
  background: linear-gradient(135deg, #0ea5e9 0%, #38bdf8 100%);
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  font-weight: 800;
  color: #fff;
  letter-spacing: -1px;
  box-shadow: 0 4px 12px rgba(14, 165, 233, 0.3);
}
.header-text h1 {
  font-size: 17px;
  font-weight: 700;
  color: #f1f5f9;
  letter-spacing: -0.3px;
}
.header-text p {
  font-size: 11px;
  color: #64748b;
  font-weight: 400;
}

/* User badge */
.user-badge {
  display: flex;
  align-items: center;
  gap: 10px;
  background: rgba(30, 41, 59, 0.7);
  border: 1px solid rgba(51, 65, 85, 0.5);
  border-radius: 8px;
  padding: 8px 12px;
  margin-top: 12px;
}
.user-avatar {
  width: 32px;
  height: 32px;
  background: linear-gradient(135deg, #3b82f6, #1d4ed8);
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
}
.user-details { flex: 1; min-width: 0; }
.user-name {
  font-size: 12px;
  font-weight: 600;
  color: #e2e8f0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.user-meta {
  font-size: 10px;
  color: #64748b;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 6px rgba(34, 197, 94, 0.5);
  flex-shrink: 0;
}
.status-dot.offline { background: #ef4444; box-shadow: 0 0 6px rgba(239, 68, 68, 0.5); }
.status-dot.busy { background: #f59e0b; box-shadow: 0 0 6px rgba(245, 158, 11, 0.5); }

/* ===== LOGIN ===== */
.login-screen {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32px 32px;
  height: calc(100% - 100px);
}
.login-logo {
  width: 56px;
  height: 56px;
  background: linear-gradient(135deg, #0ea5e9 0%, #38bdf8 100%);
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  font-weight: 800;
  color: #fff;
  margin-bottom: 20px;
  box-shadow: 0 8px 24px rgba(14, 165, 233, 0.3);
}
.login-screen h2 {
  font-size: 18px;
  color: #f1f5f9;
  font-weight: 700;
  margin-bottom: 4px;
}
.login-subtitle {
  font-size: 12px;
  color: #64748b;
  margin-bottom: 24px;
}
.input-group {
  width: 100%;
  margin-bottom: 12px;
  position: relative;
}
.input-group label {
  display: block;
  font-size: 11px;
  font-weight: 600;
  color: #94a3b8;
  margin-bottom: 4px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.input-group input {
  width: 100%;
  padding: 11px 14px;
  border: 1px solid #1e293b;
  border-radius: 8px;
  background: #0f172a;
  color: #e2e8f0;
  font-size: 13px;
  outline: none;
  transition: border-color 0.2s;
  font-family: 'Segoe UI', sans-serif;
}
.input-group input:focus {
  border-color: #0ea5e9;
  box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.1);
}
.login-btn {
  width: 100%;
  padding: 12px;
  background: linear-gradient(135deg, #0ea5e9, #38bdf8);
  color: #fff;
  border: none;
  border-radius: 8px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  margin-top: 8px;
  transition: opacity 0.15s, transform 0.1s;
  font-family: 'Segoe UI', sans-serif;
}
.login-btn:hover { opacity: 0.92; }
.login-btn:active { transform: scale(0.98); }
.login-btn:disabled { opacity: 0.5; cursor: default; }
.login-error {
  color: #f87171;
  font-size: 12px;
  margin-top: 10px;
  text-align: center;
  min-height: 16px;
}

/* ===== MAIN SCREEN ===== */
.main-screen {
  display: none;
  flex-direction: column;
  padding: 16px 20px 14px;
  height: calc(100% - 108px);
}
.section-label {
  font-size: 10px;
  font-weight: 700;
  color: #475569;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 10px;
}

/* Category buttons */
.cat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  margin-bottom: 14px;
}
.cat-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16px 8px;
  background: rgba(15, 23, 42, 0.8);
  border: 1px solid #1e293b;
  border-radius: 12px;
  color: #cbd5e1;
  cursor: pointer;
  transition: all 0.2s ease;
  font-size: 12px;
  font-weight: 500;
  font-family: 'Segoe UI', sans-serif;
  position: relative;
  overflow: hidden;
}
.cat-btn:hover {
  border-color: #0ea5e9;
  background: rgba(14, 165, 233, 0.08);
  color: #f1f5f9;
  transform: translateY(-2px);
  box-shadow: 0 4px 16px rgba(14, 165, 233, 0.15);
}
.cat-btn:active {
  transform: translateY(0);
  background: rgba(14, 165, 233, 0.15);
  border-color: #38bdf8;
}
.cat-btn:disabled {
  opacity: 0.4;
  cursor: default;
  transform: none;
}
.cat-btn .cat-icon {
  font-size: 28px;
  margin-bottom: 6px;
  line-height: 1;
}
.cat-btn .cat-label {
  font-size: 12px;
  font-weight: 600;
}
.cat-btn.sending {
  border-color: #f59e0b;
  background: rgba(245, 158, 11, 0.08);
}
.cat-btn.sent {
  border-color: #22c55e;
  background: rgba(34, 197, 94, 0.08);
}

/* Description */
.desc-section { margin-bottom: 12px; }
.desc-section textarea {
  width: 100%;
  height: 52px;
  padding: 10px 12px;
  border: 1px solid #1e293b;
  border-radius: 8px;
  background: #0f172a;
  color: #e2e8f0;
  font-size: 12px;
  resize: none;
  outline: none;
  font-family: 'Segoe UI', sans-serif;
  transition: border-color 0.2s;
}
.desc-section textarea:focus {
  border-color: #0ea5e9;
  box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.1);
}
.desc-section textarea::placeholder { color: #334155; }

/* Result card */
.result-card {
  border-radius: 10px;
  padding: 12px 14px;
  margin-bottom: 12px;
  display: none;
  animation: slideIn 0.3s ease;
}
@keyframes slideIn {
  from { opacity: 0; transform: translateY(-8px); }
  to { opacity: 1; transform: translateY(0); }
}
.result-card.success {
  display: block;
  background: rgba(34, 197, 94, 0.08);
  border: 1px solid rgba(34, 197, 94, 0.25);
}
.result-card.error {
  display: block;
  background: rgba(239, 68, 68, 0.08);
  border: 1px solid rgba(239, 68, 68, 0.25);
}
.result-card.loading {
  display: block;
  background: rgba(245, 158, 11, 0.06);
  border: 1px solid rgba(245, 158, 11, 0.2);
}
.result-card.offline {
  display: block;
  background: rgba(100, 116, 139, 0.08);
  border: 1px solid rgba(100, 116, 139, 0.25);
}
.result-title {
  font-size: 13px;
  font-weight: 700;
  margin-bottom: 4px;
}
.result-card.success .result-title { color: #4ade80; }
.result-card.error .result-title { color: #f87171; }
.result-card.loading .result-title { color: #fbbf24; }
.result-card.offline .result-title { color: #94a3b8; }
.result-detail {
  font-size: 11px;
  color: #94a3b8;
  line-height: 1.5;
}
.result-detail strong { color: #cbd5e1; }
.result-ticket {
  font-size: 14px;
  font-weight: 800;
  color: #38bdf8;
  font-family: 'Consolas', 'Courier New', monospace;
  margin-top: 4px;
}

/* Footer */
.footer-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 8px;
  border-top: 1px solid rgba(30, 41, 59, 0.5);
}
.support-status {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 10px;
  color: #64748b;
}
.support-status .dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 4px rgba(34, 197, 94, 0.5);
}
.logout-btn {
  background: none;
  border: 1px solid #1e293b;
  color: #64748b;
  padding: 5px 14px;
  border-radius: 6px;
  font-size: 10px;
  cursor: pointer;
  font-family: 'Segoe UI', sans-serif;
  transition: all 0.15s;
}
.logout-btn:hover {
  border-color: #ef4444;
  color: #f87171;
}
</style>
<script>
var SUPABASE_URL = 'https://wisbzvooxrgyltbebuyb.supabase.co';
var SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Indpc2J6dm9veHJneWx0YmVidXliIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzQ0NTQ4NzksImV4cCI6MjA5MDAzMDg3OX0.UhZJGeVW5uLJ31TN7JsDfwzUxvbRtz62sWx6wNLlSic';

var session = null;
var machineInfo = { username: 'Desconhecido', hostname: 'Desconhecido' };
var fso = null;
var sessionFilePath = '';
var pendingQueue = [];
var pendingFilePath = '';

// Init FSO for persistent storage
try {
  fso = new ActiveXObject('Scripting.FileSystemObject');
  var wshShell = new ActiveXObject('WScript.Shell');
  var appData = wshShell.ExpandEnvironmentStrings('%APPDATA%');
  var appFolder = appData + '\\ORCOMA-Suporte';
  if (!fso.FolderExists(appFolder)) fso.CreateFolder(appFolder);
  sessionFilePath = appFolder + '\\session.json';
  pendingFilePath = appFolder + '\\pending.json';
} catch(e) {}

// Get Windows machine info
try {
  var wshNetwork = new ActiveXObject('WScript.Network');
  machineInfo.username = wshNetwork.UserName;
  machineInfo.hostname = wshNetwork.ComputerName;
} catch(e) {}

function saveFile(path, data) {
  try {
    if (fso && path) {
      var f = fso.CreateTextFile(path, true);
      f.Write(data);
      f.Close();
    }
  } catch(e) {}
}

function readFile(path) {
  try {
    if (fso && path && fso.FileExists(path)) {
      var f = fso.OpenTextFile(path, 1);
      var c = f.ReadAll();
      f.Close();
      return c;
    }
  } catch(e) {}
  return null;
}

function deleteFile(path) {
  try {
    if (fso && path && fso.FileExists(path)) fso.DeleteFile(path);
  } catch(e) {}
}

function saveSession(data) { saveFile(sessionFilePath, data); }
function loadSession() { return readFile(sessionFilePath); }
function clearSession() { deleteFile(sessionFilePath); }

function getUserInitials() {
  if (!session || !session.user) return '?';
  var name = '';
  try { name = session.user.user_metadata.full_name || ''; } catch(e) {}
  if (!name && session.user.email) {
    name = session.user.email.split('@')[0];
  }
  if (!name) return '?';
  var parts = name.replace(/[._-]/g, ' ').split(' ');
  if (parts.length >= 2) return (parts[0][0] + parts[1][0]).toUpperCase();
  return name.substring(0, 2).toUpperCase();
}

function getUserDisplayName() {
  if (!session || !session.user) return 'Usuário';
  try {
    var fn = session.user.user_metadata.full_name;
    if (fn) return fn;
  } catch(e) {}
  if (session.user.email) {
    var prefix = session.user.email.split('@')[0];
    return prefix.replace(/[._-]/g, ' ').replace(/\b\w/g, function(c) { return c.toUpperCase(); });
  }
  return 'Usuário';
}

function updateUI() {
  var nameEl = document.getElementById('user-name');
  var metaEl = document.getElementById('user-meta');
  var avatarEl = document.getElementById('user-avatar');
  if (nameEl) nameEl.innerText = getUserDisplayName();
  if (metaEl) metaEl.innerText = (session && session.user ? session.user.email : '') + ' \u2022 ' + machineInfo.hostname;
  if (avatarEl) avatarEl.innerText = getUserInitials();
}

function onLoad() {
  window.resizeTo(460, 650);
  var sl = (screen.width - 460) / 2;
  var st = (screen.height - 650) / 2;
  window.moveTo(sl, st);

  // Load pending queue
  try {
    var pq = readFile(pendingFilePath);
    if (pq) pendingQueue = JSON.parse(pq);
  } catch(e) { pendingQueue = []; }

  // Restore session
  try {
    var saved = loadSession();
    if (saved) {
      session = JSON.parse(saved);
      showMainScreen();
      // Process pending queue
      if (pendingQueue.length > 0) processPendingQueue();
    }
  } catch(e) {}
}

function showMainScreen() {
  document.getElementById('login-screen').style.display = 'none';
  document.getElementById('main-screen').style.display = 'flex';
  updateUI();
}

function doLogin() {
  var email = document.getElementById('login-email').value;
  var password = document.getElementById('login-password').value;
  var errorEl = document.getElementById('login-error');
  var btn = document.getElementById('login-btn');

  if (!email || !password) {
    errorEl.innerText = 'Preencha e-mail e senha';
    return;
  }

  btn.disabled = true;
  btn.innerText = 'Conectando...';
  errorEl.innerText = '';

  var xhr = new XMLHttpRequest();
  xhr.open('POST', SUPABASE_URL + '/auth/v1/token?grant_type=password', true);
  xhr.setRequestHeader('Content-Type', 'application/json');
  xhr.setRequestHeader('apikey', SUPABASE_ANON_KEY);
  xhr.onreadystatechange = function() {
    if (xhr.readyState === 4) {
      btn.disabled = false;
      btn.innerText = 'Entrar';
      if (xhr.status === 200) {
        session = JSON.parse(xhr.responseText);
        saveSession(xhr.responseText);
        showMainScreen();
      } else {
        try {
          var err = JSON.parse(xhr.responseText);
          errorEl.innerText = err.error_description || err.msg || 'E-mail ou senha incorretos';
        } catch(e) {
          errorEl.innerText = 'Erro de conex\u00e3o. Verifique sua rede.';
        }
      }
    }
  };
  xhr.onerror = function() {
    btn.disabled = false;
    btn.innerText = 'Entrar';
    errorEl.innerText = 'Sem conex\u00e3o com o servidor';
  };
  xhr.send(JSON.stringify({ email: email, password: password }));
}

function doLogout() {
  session = null;
  clearSession();
  document.getElementById('login-screen').style.display = 'flex';
  document.getElementById('main-screen').style.display = 'none';
  document.getElementById('login-email').value = '';
  document.getElementById('login-password').value = '';
  document.getElementById('login-error').innerText = '';
  hideResult();
}

function showResult(type, title, detail) {
  var card = document.getElementById('result-card');
  card.className = 'result-card ' + type;
  document.getElementById('result-title').innerText = title;
  document.getElementById('result-detail').innerHTML = detail;
}

function hideResult() {
  var card = document.getElementById('result-card');
  card.className = 'result-card';
  card.style.display = 'none';
}

function setButtonState(cat, state) {
  var btns = document.getElementsByClassName('cat-btn');
  for (var i = 0; i < btns.length; i++) {
    var btnCat = btns[i].getAttribute('data-cat');
    if (state === 'sending') {
      btns[i].disabled = true;
      if (btnCat === cat) btns[i].className = 'cat-btn sending';
    } else if (state === 'sent') {
      btns[i].disabled = false;
      if (btnCat === cat) {
        btns[i].className = 'cat-btn sent';
        setTimeout(function() {
          try { btns[i].className = 'cat-btn'; } catch(e) {}
        }, 2000);
      }
    } else {
      btns[i].disabled = false;
      btns[i].className = 'cat-btn';
    }
  }
}

function formatTime(isoStr) {
  try {
    var d = new Date(isoStr);
    var h = d.getHours(); var m = d.getMinutes();
    return (h < 10 ? '0' : '') + h + ':' + (m < 10 ? '0' : '') + m;
  } catch(e) { return '--:--'; }
}

function ensureValidToken(callback) {
  if (!session || !session.access_token) {
    doLogout();
    showResult('error', '\u274C Sess\u00e3o expirada', 'Fa\u00e7a login novamente.');
    return;
  }
  // Check if token is expired by trying to decode
  try {
    var parts = session.access_token.split('.');
    if (parts.length === 3) {
      var payload = JSON.parse(atob(parts[1]));
      var now = Math.floor(new Date().getTime() / 1000);
      if (payload.exp && payload.exp < now + 60) {
        // Token expired or about to expire, refresh first
        refreshToken(function(ok) {
          if (ok) { callback(); }
          else {
            doLogout();
            showResult('error', '\u274C Sess\u00e3o expirada', 'Fa\u00e7a login novamente.');
          }
        });
        return;
      }
    }
  } catch(e) {}
  callback();
}

function refreshToken(callback) {
  if (!session || !session.refresh_token) {
    callback(false);
    return;
  }
  var xhr = new XMLHttpRequest();
  xhr.open('POST', SUPABASE_URL + '/auth/v1/token?grant_type=refresh_token', true);
  xhr.setRequestHeader('Content-Type', 'application/json');
  xhr.setRequestHeader('apikey', SUPABASE_ANON_KEY);
  xhr.onreadystatechange = function() {
    if (xhr.readyState === 4) {
      if (xhr.status === 200) {
        session = JSON.parse(xhr.responseText);
        saveSession(xhr.responseText);
        callback(true);
      } else {
        callback(false);
      }
    }
  };
  xhr.onerror = function() { callback(false); };
  xhr.send(JSON.stringify({ refresh_token: session.refresh_token }));
}

function createTicket(categoria) {
  var descricao = document.getElementById('description').value;

  if (!session) {
    showResult('error', '\u274C Sess\u00e3o expirada', 'Fa\u00e7a login novamente.');
    return;
  }

  setButtonState(categoria, 'sending');
  showResult('loading', '\u23F3 Enviando chamado...', 'Aguarde um momento...');

  ensureValidToken(function() {
    var xhr = new XMLHttpRequest();
    xhr.open('POST', SUPABASE_URL + '/functions/v1/support-ticket', true);
    xhr.setRequestHeader('Content-Type', 'application/json');
    xhr.setRequestHeader('Authorization', 'Bearer ' + session.access_token);
    xhr.setRequestHeader('apikey', SUPABASE_ANON_KEY);
    xhr.onreadystatechange = function() {
      if (xhr.readyState === 4) {
        if (xhr.status === 200 || xhr.status === 201) {
          try {
            var res = JSON.parse(xhr.responseText);
            setButtonState(categoria, 'sent');
            showResult('success',
              '\u2705 Chamado criado com sucesso!',
              '<strong>Protocolo:</strong> <span class="result-ticket">#' + (res.ticket_number || '---') + '</span><br>' +
              '<strong>Categoria:</strong> ' + (res.category || categoria) + '<br>' +
              '<strong>Respons\u00e1vel:</strong> ' + (res.assigned_to_name || 'Suporte') + '<br>' +
              '<strong>Hor\u00e1rio:</strong> ' + formatTime(res.created_at)
            );
            document.getElementById('description').value = '';
            setTimeout(hideResult, 8000);
          } catch(e) {
            setButtonState(categoria, 'sent');
            showResult('success', '\u2705 Chamado criado!', 'Chamado registrado com sucesso.');
            setTimeout(hideResult, 5000);
          }
        } else if (xhr.status === 401) {
          // Token rejected, try refresh once
          refreshToken(function(ok) {
            if (ok) { createTicket(categoria); }
            else {
              setButtonState(categoria, 'reset');
              doLogout();
              showResult('error', '\u274C Sess\u00e3o expirada', 'Fa\u00e7a login novamente.');
            }
          });
        } else {
          setButtonState(categoria, 'reset');
          try {
            var err = JSON.parse(xhr.responseText);
            showResult('error', '\u274C Erro ao criar chamado', (err.error || 'Tente novamente.') + '<br><a href="#" onclick="createTicket(\'' + categoria + '\'); return false;" style="color:#38bdf8;font-size:11px;">Tentar novamente</a>');
          } catch(e) {
            showResult('error', '\u274C Erro inesperado', 'Tente novamente em alguns segundos.');
          }
        }
      }
    };
    xhr.onerror = function() {
      setButtonState(categoria, 'reset');
      pendingQueue.push({ categoria: categoria, descricao: descricao, timestamp: new Date().toISOString() });
      saveFile(pendingFilePath, JSON.stringify(pendingQueue));
      showResult('offline', '\u26A0 Falha na conex\u00e3o', 'Chamado salvo na fila local.');
    };
    xhr.send(JSON.stringify({
      categoria: categoria,
      descricao: descricao || null,
      usuario_windows: machineInfo.username,
      nome_maquina: machineInfo.hostname
    }));
  });
}


function processPendingQueue() {
  if (pendingQueue.length === 0) return;
  var item = pendingQueue.shift();
  saveFile(pendingFilePath, JSON.stringify(pendingQueue));

  var xhr = new XMLHttpRequest();
  xhr.open('POST', SUPABASE_URL + '/functions/v1/support-ticket', true);
  xhr.setRequestHeader('Content-Type', 'application/json');
  xhr.setRequestHeader('Authorization', 'Bearer ' + session.access_token);
  xhr.setRequestHeader('apikey', SUPABASE_ANON_KEY);
  xhr.onreadystatechange = function() {
    if (xhr.readyState === 4) {
      if (xhr.status === 200 || xhr.status === 201) {
        if (pendingQueue.length > 0) {
          setTimeout(processPendingQueue, 1000);
        }
      } else {
        pendingQueue.unshift(item);
        saveFile(pendingFilePath, JSON.stringify(pendingQueue));
      }
    }
  };
  xhr.onerror = function() {
    pendingQueue.unshift(item);
    saveFile(pendingFilePath, JSON.stringify(pendingQueue));
  };
  xhr.send(JSON.stringify({
    categoria: item.categoria,
    descricao: item.descricao || null,
    usuario_windows: machineInfo.username,
    nome_maquina: machineInfo.hostname
  }));
}

function handleKeyPress(e) {
  if (e.keyCode === 13) doLogin();
}

// Retry pending queue periodically
setInterval(function() {
  if (session && pendingQueue.length > 0) processPendingQueue();
}, 60000);
</script>
</head>
<body onload="onLoad()">

<!-- HEADER -->
<div class="header">
  <div class="header-top">
    <div class="logo-icon">O</div>
    <div class="header-text">
      <h1>ORCOMA Suporte</h1>
      <p>Abertura r&aacute;pida de chamados</p>
    </div>
  </div>
  <div class="user-badge" id="user-badge" style="display:none">
    <div class="user-avatar" id="user-avatar">?</div>
    <div class="user-details">
      <div class="user-name" id="user-name">Usu&aacute;rio</div>
      <div class="user-meta" id="user-meta"></div>
    </div>
    <div class="status-dot" id="status-dot" title="Suporte dispon&iacute;vel"></div>
  </div>
</div>

<!-- LOGIN SCREEN -->
<div id="login-screen" class="login-screen">
  <div class="login-logo">O</div>
  <h2>Bem-vindo</h2>
  <p class="login-subtitle">Entre com seu e-mail corporativo</p>
  <div class="input-group">
    <label>E-mail</label>
    <input type="text" id="login-email" placeholder="seu.nome@orcoma.com.br" />
  </div>
  <div class="input-group">
    <label>Senha</label>
    <input type="password" id="login-password" placeholder="&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;" onkeypress="handleKeyPress(event)" />
  </div>
  <button class="login-btn" id="login-btn" onclick="doLogin()">Entrar</button>
  <div class="login-error" id="login-error"></div>
</div>

<!-- MAIN SCREEN -->
<div id="main-screen" class="main-screen">
  <div class="section-label">Tipo do chamado</div>
  <div class="cat-grid">
    <button class="cat-btn" data-cat="computador" onclick="createTicket('computador')">
      <span class="cat-icon">&#128187;</span>
      <span class="cat-label">Computador</span>
    </button>
    <button class="cat-btn" data-cat="sistema" onclick="createTicket('sistema')">
      <span class="cat-icon">&#128203;</span>
      <span class="cat-label">Sistema</span>
    </button>
    <button class="cat-btn" data-cat="impressora" onclick="createTicket('impressora')">
      <span class="cat-icon">&#128424;</span>
      <span class="cat-label">Impressora</span>
    </button>
    <button class="cat-btn" data-cat="ramal" onclick="createTicket('ramal')">
      <span class="cat-icon">&#9742;&#65039;</span>
      <span class="cat-label">Ramal</span>
    </button>
  </div>

  <div class="desc-section">
    <div class="section-label">Descri&ccedil;&atilde;o (opcional)</div>
    <textarea id="description" placeholder="Descreva o problema rapidamente..."></textarea>
  </div>

  <!-- Result card -->
  <div class="result-card" id="result-card">
    <div class="result-title" id="result-title"></div>
    <div class="result-detail" id="result-detail"></div>
  </div>

  <div class="footer-bar">
    <div class="support-status">
      <span class="dot"></span>
      Suporte dispon&iacute;vel
    </div>
    <button class="logout-btn" onclick="doLogout()">Sair</button>
  </div>
</div>

<script>
// Show/hide user badge based on screen
var origShow = showMainScreen;
showMainScreen = function() {
  origShow();
  document.getElementById('user-badge').style.display = 'flex';
};
var origLogout = doLogout;
doLogout = function() {
  document.getElementById('user-badge').style.display = 'none';
  origLogout();
};
</script>
</body>
</html>
