{
  "name": "orcoma-suporte",
  "version": "1.0.0",
  "description": "App de chamados rápidos - ORCOMA",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.orcoma.suporte",
    "productName": "ORCOMA Suporte",
    "win": {
      "target": "portable",
      "icon": "icon.png"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "index.html",
      "style.css",
      "renderer.js",
      "icon.png"
    ]
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.2"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "@electron/packager": "^18.0.0"
  }
}
